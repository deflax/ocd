# Ignore everything in data/ except .gitkeep
data/*
!data/.gitkeep

# Local config overrides (may contain sensitive keys/settings)
config/opencode.local.json
config/opencode.merged.json
config/oh-my-opencode.local.json
config/oh-my-opencode.merged.json

# Claude OAuth token (sensitive)
.claude-token

# Temporary files (cloned repos, build artifacts)
tmp/