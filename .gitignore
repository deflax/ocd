config/opencode.local.json
config/opencode.merged.json
config/oh-my-opencode-slim.local.json
config/.oh-my-opencode-slim.*.json

# Temporary files (cloned repos, build artifacts)
tmp/
.playwright-mcp/
.sisyphus/
.omo/
