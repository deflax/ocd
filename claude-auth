#!/usr/bin/env bash

set -e

# Get the actual script location (resolving symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Configuration
TOKEN_FILE="${SCRIPT_DIR}/.claude-token"

usage() {
    cat <<'EOF'
Usage: ./claude-auth [command]

Manage Claude Code authentication for the OCD container.

Commands:
  setup-token   Generate a long-lived OAuth token (default)
  status        Check current authentication status
  logout        Remove Claude credentials

Flow:
  1. Run ./claude-auth setup-token
  2. A browser opens on your machine — authorize once
  3. Paste the token when prompted
  4. Token is saved and injected into every container run

Credentials persist across container restarts.
EOF
}

do_setup_token() {
    local token="$1"

    if [ -z "$token" ]; then
        echo "=== Claude Code Token Setup ==="
        echo ""
        echo "This generates a long-lived OAuth token (valid ~1 year)."
        echo "A browser will open on this machine — authorize and copy the token."
        echo ""

        # Run claude setup-token: use local install, or npx as fallback
        if command -v claude >/dev/null 2>&1; then
            claude setup-token
        elif command -v npx >/dev/null 2>&1; then
            echo "Claude CLI not found locally — running via npx (temporary, no install)..."
            echo ""
            npx --yes @anthropic-ai/claude-code@2.1.104 setup-token
        else
            echo "Error: Neither 'claude' nor 'npx' found on this machine." >&2
            echo "" >&2
            echo "Install Node.js (which includes npx), then re-run this command." >&2
            echo "Or install Claude CLI manually: npm install -g @anthropic-ai/claude-code@2.1.104" >&2
            exit 1
        fi

        echo ""
        echo "Paste the token below (sk-ant-oat01-...):"
        read -r -p "> " token
    fi

    if [ -z "$token" ]; then
        echo "Error: No token provided." >&2
        exit 1
    fi

    # Validate token format
    if [[ ! "$token" =~ ^sk-ant-oat ]]; then
        echo "Warning: Token doesn't look like a Claude OAuth token (expected sk-ant-oat...)."
        echo "Saving anyway — if auth fails, re-run this command."
    fi

    # Save token
    echo "$token" > "$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
    echo ""
    echo "Token saved to .claude-token"
    echo "The ocd script will pass CLAUDE_CODE_OAUTH_TOKEN into the container automatically."
    echo ""
    echo "You can now run: ./ocd"
}

# Parse command
CMD="${1:-setup-token}"

case "$CMD" in
    setup-token)
        do_setup_token "$2"
        ;;
    status)
        if [ -f "$TOKEN_FILE" ]; then
            echo "OAuth token file: .claude-token"
            echo "Token prefix: $(head -c 20 "$TOKEN_FILE")..."
        else
            echo "No token found. Run ./claude-auth setup-token to authenticate."
        fi
        ;;
    logout)
        if [ -f "$TOKEN_FILE" ]; then
            rm -f "$TOKEN_FILE"
            echo "Removed .claude-token"
        else
            echo "No token file found."
        fi
        echo "Claude credentials cleared."
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        echo "Unknown command: $CMD" >&2
        echo ""
        usage >&2
        exit 1
        ;;
esac
