#!/usr/bin/env bash

set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

DATA_DIR="${SCRIPT_DIR}/data"
DRY_RUN=false

usage() {
  cat <<'EOF'
Usage: ./clearcache [--dry-run]

Clears persistent runtime data while preserving OpenCode sessions, login state,
and configuration.

Preserves:
  data/.config/               OpenCode settings and plugin metadata, except node_modules
  data/.local/share/opencode/auth.json
  data/.local/share/opencode/opencode.db*
  data/.local/share/opencode/snapshot/
  data/.local/share/opencode/storage/session_diff/
  config/                     All configuration (mounted read-only in container)

Options:
  --dry-run   Show what would be removed without deleting
  -h, --help  Show help
EOF
}

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown argument: %s\n\n' "$arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

declare -a TARGETS=()

add_cleanup_targets() {
  local path
  [ -d "$DATA_DIR" ] || return 0

  for path in "$DATA_DIR"/* "$DATA_DIR"/.[!.]* "$DATA_DIR"/..?*; do
    [ -e "$path" ] || continue
    case "$path" in
      "${DATA_DIR}/.config"|"${DATA_DIR}/.local") ;;
      *) TARGETS+=("$path") ;;
    esac
  done

  if [ -d "${DATA_DIR}/.local" ]; then
    for path in "${DATA_DIR}/.local"/* "${DATA_DIR}/.local"/.[!.]* "${DATA_DIR}/.local"/..?*; do
      [ -e "$path" ] || continue
      case "$path" in
        "${DATA_DIR}/.local/share") ;;
        *) TARGETS+=("$path") ;;
      esac
    done
  fi

  if [ -d "${DATA_DIR}/.local/share" ]; then
    for path in "${DATA_DIR}/.local/share"/* "${DATA_DIR}/.local/share"/.[!.]* "${DATA_DIR}/.local/share"/..?*; do
      [ -e "$path" ] || continue
      case "$path" in
        "${DATA_DIR}/.local/share/opencode") ;;
        *) TARGETS+=("$path") ;;
      esac
    done
  fi

  if [ -d "${DATA_DIR}/.local/share/opencode" ]; then
    for path in "${DATA_DIR}/.local/share/opencode"/* "${DATA_DIR}/.local/share/opencode"/.[!.]* "${DATA_DIR}/.local/share/opencode"/..?*; do
      [ -e "$path" ] || continue
      case "$path" in
        "${DATA_DIR}/.local/share/opencode/auth.json"|\
        "${DATA_DIR}/.local/share/opencode/opencode.db"|\
        "${DATA_DIR}/.local/share/opencode/opencode.db-shm"|\
        "${DATA_DIR}/.local/share/opencode/opencode.db-wal"|\
        "${DATA_DIR}/.local/share/opencode/snapshot"|\
        "${DATA_DIR}/.local/share/opencode/storage") ;;
        *) TARGETS+=("$path") ;;
      esac
    done
  fi

  if [ -d "${DATA_DIR}/.local/share/opencode/storage" ]; then
    for path in "${DATA_DIR}/.local/share/opencode/storage"/* "${DATA_DIR}/.local/share/opencode/storage"/.[!.]* "${DATA_DIR}/.local/share/opencode/storage"/..?*; do
      [ -e "$path" ] || continue
      case "$path" in
        "${DATA_DIR}/.local/share/opencode/storage/session_diff") ;;
        *) TARGETS+=("$path") ;;
      esac
    done
  fi
}

target_is_covered() {
  local candidate="$1"
  local target
  for target in "${TARGETS[@]}"; do
    if [[ "$candidate" == "$target" || "$candidate" == "$target"/* ]]; then
      return 0
    fi
  done
  return 1
}

add_cleanup_targets

if [ -d "$DATA_DIR" ]; then
  while IFS= read -r -d '' node_modules_dir; do
    if ! target_is_covered "$node_modules_dir"; then
      TARGETS+=("$node_modules_dir")
    fi
  done < <(find "$DATA_DIR" -type d -name node_modules -prune -print0)
fi

normalize_targets() {
  local candidate
  local other
  local existing
  local covered
  declare -a normalized=()

  for candidate in "${TARGETS[@]}"; do
    covered=false
    for other in "${TARGETS[@]}"; do
      if [[ "$candidate" != "$other" && "$candidate" == "$other"/* ]]; then
        covered=true
        break
      fi
    done
    [ "$covered" = false ] || continue

    for existing in "${normalized[@]}"; do
      if [ "$candidate" = "$existing" ]; then
        covered=true
        break
      fi
    done
    [ "$covered" = false ] || continue

    normalized+=("$candidate")
  done

  TARGETS=("${normalized[@]}")
}

normalize_targets

removed=0
freed_desc=""
for target in "${TARGETS[@]}"; do
  if [ -e "$target" ]; then
    if [ "$DRY_RUN" = true ]; then
      # Show size of what would be removed
      size=$(du -sh "$target" 2>/dev/null | cut -f1 || echo "?")
      printf '[dry-run] remove %-50s (%s)\n' "$target" "$size"
    else
      rm -rf "$target"
      printf 'removed %s\n' "$target"
    fi
    removed=$((removed + 1))
  fi
done

if [ "$removed" -eq 0 ]; then
  printf 'No cache artifacts found.\n'
else
  if [ "$DRY_RUN" = true ]; then
    printf '\n[dry-run] %d item(s) would be removed.\n' "$removed"
  else
    printf '\nDone. Removed %d cache artifact(s).\n' "$removed"
    printf 'Caches will be rebuilt automatically on next OpenCode launch.\n'
  fi
fi
