{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",

  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4"
    },
    "atlas": {
      "model": "openai/gpt-5.4-mini"
    },
    "prometheus": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high"
    },
    "metis": {
      "model": "openai/gpt-5.4"
    },
    "momus": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "fallback_models": ["openai/gpt-5.4"]
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "fallback_models": ["openai/gpt-5.3-codex"]
    }
  },
  "categories": {
    "quick": {
      "model": "openai/gpt-5.4-mini"
    },
    "deep": {
      "model": "openai/gpt-5.3-codex",
      "reasoningEffort": "high",
      "fallback_models": ["openai/gpt-5.4"]
    },
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.4-mini"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.4"
    },
    "writing": {
      "model": "openai/gpt-5.4"
    },
    "visual-engineering": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "medium"
    },
    "artistry": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high"
    }
  },

  "background_task": {
    "providerConcurrency": { "openai": 20, "opencode": 3 },
    "modelConcurrency": { "openai/gpt-5.4-mini": 20 }
  },

  "disabled_skills": [
    "playwright"
  ],

  "disabled_hooks": [
  ]
}
