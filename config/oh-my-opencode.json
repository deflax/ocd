{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",

  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-4-6",
      "ultrawork": { "model": "anthropic/claude-opus-4-6", "variant": "max" }
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "ultrawork": { "model": "openai/gpt-5.3-codex", "variant": "xhigh" }
    },
    "librarian": { "model": "openai/gpt-5.2" },
    "explore":   { "model": "openai/gpt-5.2" },
    "oracle": { "model": "openai/gpt-5.4", "variant": "high" },
    "prometheus": { "prompt_append": "Leverage deep & quick agents heavily, always in parallel." }
  },

  "categories": {
    "visual-engineering": { "model": "anthropic/claude-opus-4-6", "variant": "high" },
    "ultrabrain": { "model": "openai/gpt-5.4", "variant": "xhigh" },
    "deep": { "model": "openai/gpt-5.4", "variant": "high" },
    "artistry": { "model": "anthropic/claude-opus-4-6", "variant": "high" },
    "quick": { "model": "openai/gpt-5.4" },
    "unspecified-high": { "model": "openai/gpt-5.4", "variant": "max" },
    "unspecified-low": { "model": "openai/gpt-5.2" },
    "writing": { "model": "anthropic/claude-sonnet-4-6" }
  },

  "background_task": {
    "providerConcurrency": { "anthropic": 3, "openai": 3, "opencode": 10 },
    "modelConcurrency": { "anthropic/claude-opus-4-6": 2, "opencode/gpt-5.2": 20 }
  },

  "disabled_skills": [
    "playwright"
  ]
}
