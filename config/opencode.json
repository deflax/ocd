{
  "$schema": "https://opencode.ai/v2/config.json",
  "update": "disable",
  "default_agent": "orchestrator",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/config/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "list", "resource": "*", "effect": "allow" },
    { "action": "lsp", "resource": "*", "effect": "allow" },
    { "action": "todoread", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" }
  ],
  "providers": {
    "ollama": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
        "num_ctx": 16384
      },
      "models": {
        "gemma4:26b-16k": {
          "name": "gemma4:26b-16k",
          "tool_call": true
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    }
  },
  "agents": {
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "disabled": true
    },
    "build": {
      "model": "openai/gpt-5.6-terra",
      "disabled": true
    },
    "research": {
      "description": "Read-only research and analysis agent.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "disabled": false,
      "hidden": false,
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "lsp", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" }
      ]
    },
    "hallucinator": {
      "model": "openai/gpt-6-luna"
    }
  },
  "plugins": [
    "oh-my-opencode-slim@2.2.20"
  ],
  "skills": ["/config/skills"],
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "env",
          "-u",
          "PLAYWRIGHT_MCP_BROWSER",
          "playwright-mcp",
          "--isolated",
          "--config",
          "/config/playwright-mcp.json"
        ],
        "disabled": false
      }
    }
  }
}
