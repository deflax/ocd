{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "research",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/config/skills/**": "allow",
      "/tmp": "allow",
      "/tmp/**": "allow"
    },
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git push *": "deny",
      "sudo *": "deny",
      "su *": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "num_ctx": 16384
      },
      "models": {   
	"gemma4:26b-16k": {
	  "name": "gemma4:26b-16k",
	  "tool_call": true
	}
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra",
      "disable": true
    },
    "build": {
      "model": "openai/gpt-5.6-terra",
      "disable": true
    },
    "research": {
      "description": "Read-only research and analysis agent.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "disable": false,
      "hidden": false,
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny"
      }
    }
  },
  "plugin": [
    "oh-my-opencode-slim@2.2.20",
    "@slkiser/opencode-quota@4.9.0"
  ],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "env",
        "-u",
        "PLAYWRIGHT_MCP_BROWSER",
        "playwright-mcp",
        "--isolated",
        "--config",
        "/config/playwright-mcp.json"
      ],
      "enabled": true
    }
  }
}
