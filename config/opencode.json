{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "external_directory": "deny",
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd *": "allow",
      "cd *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "tree *": "allow",
      "find *": "allow",
      "which *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ag *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "diff *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "git status *": "allow",
      "GIT_MASTER=1 git status *": "allow",
      "git diff *": "allow",
      "GIT_MASTER=1 git diff *": "allow",
      "git log *": "allow",
      "GIT_MASTER=1 git log *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "git push *": "deny",
      "git stash list *": "allow",
      "git remote *": "allow",
      "git tag *": "allow",
      "git blame *": "allow",
      "git shortlog *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git cat-file *": "allow",
      "git describe *": "allow",
      "python3 *": "allow",
      "pip3 *": "allow",
      "pip *": "allow",
      "pytest *": "allow",
      "go *": "allow",
      "make *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "bun *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "tsc *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "jq *": "allow",
      "yq *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "env *": "allow",
      "printenv *": "allow",
      "date *": "allow",
      "whoami *": "allow",
      "uname *": "allow",
      "xargs *": "allow",
      "sudo *": "deny",
      "su *": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "num_ctx": 16384
      },
      "models": {   
	"gemma4:26b-16k": {
	  "name": "gemma4:26b-16k",
	  "tool_call": true
	}
      }
    }
  },
  "plugin": [
    "opencode-claude-auth@1.5.0",
    "oh-my-openagent@3.17.4",
    "@tarquinen/opencode-dcp@3.1.9",
    "@slkiser/opencode-quota@3.0.2"
  ]
}
