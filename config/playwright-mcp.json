{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": false,
      "chromiumSandbox": false,
      "args": [
        "--test-type",
        "--disable-gpu",
        "--disable-software-rasterizer",
        "--disable-features=CDPScreenshotNewSurface"
      ]
    }
  }
}
