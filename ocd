#!/usr/bin/env bash

set -e

# Get the actual script location (resolving symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Get the current working directory (where script is run from)
CURRENT_DIR="$(pwd)"

# Configuration
IMAGE_NAME="ocd:latest"
CONTAINER_NAME_PREFIX="${OCD_CONTAINER_NAME_PREFIX:-ocd}"
CONTAINER_NAME="${CONTAINER_NAME_PREFIX}-$(date +%Y%m%d-%H%M%S)-$$"

# Check if image exists
if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
    echo "Error: Image '${IMAGE_NAME}' not found."
    echo "Please run ./build first to build the image."
    exit 1
fi

# Config: merge local overrides on top of base config if they exist.
# NOTE: jq's `*` operator merges objects recursively but REPLACES arrays wholesale.
# If the base has "plugins": ["a","b"] and local has "plugins": ["c"], the result is ["c"].
# This is intentional — local overrides are full replacements for array fields.
OPENCODE_CONFIG_HOST="${SCRIPT_DIR}/config/opencode.json"
if [ -f "${SCRIPT_DIR}/config/opencode.local.json" ]; then
    echo "Merging opencode.local.json into opencode.json..."
    jq -s '.[0] * .[1]' \
        "${SCRIPT_DIR}/config/opencode.json" \
        "${SCRIPT_DIR}/config/opencode.local.json" \
        > "${SCRIPT_DIR}/config/opencode.merged.json"
    OPENCODE_CONFIG_HOST="${SCRIPT_DIR}/config/opencode.merged.json"
fi

# oh-my-opencode config: merge local overrides if they exist (same array-replace semantics as above).
# NOTE: tui.json is NOT part of the merge flow — it is read directly by OpenCode from the config dir.
OMO_CONFIG_HOST="${SCRIPT_DIR}/config/oh-my-opencode.json"
if [ -f "${SCRIPT_DIR}/config/oh-my-opencode.local.json" ]; then
    echo "Merging oh-my-opencode.local.json into oh-my-opencode.json..."
    jq -s '.[0] * .[1]' \
        "${SCRIPT_DIR}/config/oh-my-opencode.json" \
        "${SCRIPT_DIR}/config/oh-my-opencode.local.json" \
        > "${SCRIPT_DIR}/config/oh-my-opencode.merged.json"
    OMO_CONFIG_HOST="${SCRIPT_DIR}/config/oh-my-opencode.merged.json"
fi

# Claude Code OAuth token: read from .claude-token file or env var,
# then seed ~/.claude/.credentials.json so the opencode-claude-auth plugin can read it.
CLAUDE_TOKEN_FILE="${SCRIPT_DIR}/.claude-token"
if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    : # env var already set, use as-is
elif [ -f "$CLAUDE_TOKEN_FILE" ]; then
    CLAUDE_CODE_OAUTH_TOKEN="$(cat "$CLAUDE_TOKEN_FILE")"
fi

if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    CLAUDE_CRED_DIR="${SCRIPT_DIR}/data/.claude"
    CLAUDE_CRED_FILE="${CLAUDE_CRED_DIR}/.credentials.json"
    mkdir -p "$CLAUDE_CRED_DIR"
    printf '{"claudeAiOauth":{"accessToken":"%s","refreshToken":"","expiresAt":1800000000000}}\n' \
        "$CLAUDE_CODE_OAUTH_TOKEN" > "$CLAUDE_CRED_FILE"
    chmod 600 "$CLAUDE_CRED_FILE"
fi

# X11 clipboard support: mount the socket dir only if it exists
X11_MOUNT=()
if [ -d /tmp/.X11-unix ]; then
    X11_MOUNT=(-v /tmp/.X11-unix:/tmp/.X11-unix:ro)
fi

# Run the container
echo "Starting container '${CONTAINER_NAME}' using ${CURRENT_DIR} as workspace. Script is run from ${SCRIPT_DIR}"
docker run -it \
    --rm \
    --name "${CONTAINER_NAME}" \
    --network host \
    -v "${SCRIPT_DIR}/data:/home/coder:rw" \
    -v "${OPENCODE_CONFIG_HOST}:/config/opencode.json:ro" \
    -v "${OMO_CONFIG_HOST}:/config/oh-my-opencode.json:ro" \
    -v "${CURRENT_DIR}:/workspace:rw" \
    "${X11_MOUNT[@]}" \
    -w /workspace \
    -e HOME=/home/coder \
    -e PATH="/home/coder/.local/bin:${PATH}" \
    -e DISPLAY="${DISPLAY:-}" \
    -e OPENCODE_API_KEY="${OPENCODE_API_KEY:-}" \
    -e OPENCODE_CONFIG=/config/opencode.json \
    -e OPENCODE_CONFIG_DIR=/config \
    --security-opt no-new-privileges:true \
    --cap-drop ALL \
    --cap-add CHOWN \
    --cap-add SETUID \
    --cap-add SETGID \
    "${IMAGE_NAME}" \
    "$@"
